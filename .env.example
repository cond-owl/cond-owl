# Copie para .env e preencha. Use SOMENTE a chave anon/public (nunca service_role).
EXPO_PUBLIC_SUPABASE_URL= url_do_supabase
EXPO_PUBLIC_SUPABASE_ANON_KEY= chaveanonima

# Firebase (notificações push). Sem estes valores o app abre normalmente e as
# notificações ficam desativadas. Use a configuração web do seu projeto Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=chave_api_do_firebase
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
EXPO_PUBLIC_FIREBASE_VAPID_KEY=chave_vapid
