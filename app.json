{
  "expo": {
    "name": "CondoOwl",
    "slug": "condoapp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "condoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.roberiopmfsteam.condoapp"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "CondoOwl",
      "shortName": "CondoOwl",
      "themeColor": "#0f172a",
      "backgroundColor": "#0f172a",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b7edc92-e603-4a5e-bcc7-a0763363716b"
      }
    },
    "owner": "roberiopmfs-team"
  }
}
